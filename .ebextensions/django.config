option_settings:
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static: static
  aws:elasticbeanstalk:container:python:
    WSGIPath: smartshelf_project.wsgi:application
  
  # Environment variables for your RDS, DynamoDB, and Admin credentials
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: smartshelf_project.settings
    PYTHONPATH: "/var/app/current:$PYTHONPATH"
    AWS_REGION: us-east-1 
    # Defined credentials for the default admin
    DJANGO_SUPERUSER_USERNAME: admin
    DJANGO_SUPERUSER_EMAIL: x24307891@student.ncirl.ie
    DJANGO_SUPERUSER_PASSWORD: YourSecurePassword123

container_commands:
  01_migrate:
    # Safely find the activation script and migrate.
    command: "source $(find /var/app/venv -name activate -type f | head -n 1) && python manage.py migrate --run-syncdb || true"
    leader_only: true
  02_collectstatic:
    command: "source $(find /var/app/venv -name activate -type f | head -n 1) && python manage.py collectstatic --noinput || true"
    leader_only: true
  03_create_superuser:
    # Updated to use environment variables for better security and flexibility
    command: "source $(find /var/app/venv -name activate -type f | head -n 1) && python manage.py shell -c \"from django.contrib.auth import get_user_model; User = get_user_model(); username = '$DJANGO_SUPERUSER_USERNAME'; email = '$DJANGO_SUPERUSER_EMAIL'; password = '$DJANGO_SUPERUSER_PASSWORD'; User.objects.filter(username=username).exists() or User.objects.create_superuser(username, email, password)\" || true"
    leader_only: true
  04_chown_sqlite:
    # Give webapp user ownership of sqlite database and staging dir so it can read/write data
    command: "chown -R webapp:webapp /var/app/staging/ || true"