option_settings:
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static: static
  aws:elasticbeanstalk:container:python:
    WSGIPath: smartshelf_project.wsgi:application
  
  # Environment variables for your RDS and DynamoDB connections
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: smartshelf_project.settings
    PYTHONPATH: "/var/app/current:$PYTHONPATH"
    # Ensure your AWS Region is set for DynamoDB/Boto3
    AWS_REGION: us-east-1 

container_commands:
  01_migrate:
    # Runs the RDS migrations using the new PyMySQL driver
    command: "source /var/app/venv/*/bin/activate && python manage.py migrate --run-syncdb"
    leader_only: true
  02_collectstatic:
    # Prepares static files for the Nginx proxy
    command: "source /var/app/venv/*/bin/activate && python manage.py collectstatic --noinput"
    leader_only: true
  03_create_superuser:
    # Ensures examiners (Vikas Sahni/Rohit Verma) have immediate access
    command: "source /var/app/venv/*/bin/activate && python manage.py shell -c \"from django.contrib.auth.models import User; User.objects.filter(username='admin').exists() or User.objects.create_superuser('admin', 'admin@smartshelf.com', 'admin')\""
    leader_only: true