option_settings:
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static: static
  aws:elasticbeanstalk:container:python:
    WSGIPath: smartshelf_project.wsgi:application
  
  # Environment variables for your RDS and DynamoDB connections
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: smartshelf_project.settings
    PYTHONPATH: "/var/app/current:$PYTHONPATH"
    # Ensure your AWS Region is set for DynamoDB/Boto3
    AWS_REGION: us-east-1 

container_commands:
  01_migrate:
    # Safely find the activation script and migrate. Allow to fail since db.sqlite3 is already committed.
    command: "source $(find /var/app/venv -name activate -type f | head -n 1) && python manage.py migrate --run-syncdb || true"
    leader_only: true
  02_collectstatic:
    command: "source $(find /var/app/venv -name activate -type f | head -n 1) && python manage.py collectstatic --noinput || true"
    leader_only: true
  03_create_superuser:
    command: "source $(find /var/app/venv -name activate -type f | head -n 1) && python manage.py shell -c \"from django.contrib.auth.models import User; User.objects.filter(username='admin').exists() or User.objects.create_superuser('admin', 'admin@smartshelf.com', 'admin')\" || true"
    leader_only: true
  04_chown_sqlite:
    # Give webapp user ownership of sqlite database and staging dir so it can read/write data
    command: "chown -R webapp:webapp /var/app/staging/ || true"